# Copy to .env and adjust. All values are optional for local development.

# Port for the API server (and the whole site in production)
PORT=8787

# Public URL of the site: used in email links and to allow requests from it
APP_URL=http://localhost:5173
# Extra allowed origins, comma-separated
ALLOWED_ORIGINS=

# Where the SQLite database lives
DB_FILE=server/data/quizora.db

# How long a login lasts
SESSION_DAYS=30

# Real emails (verification + password reset) via https://resend.com
# Without a key, emails are printed in the server console and listed at /api/dev/outbox.
RESEND_API_KEY=
MAIL_FROM=Quizora <no-reply@yourdomain.com>
