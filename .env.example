# Copy to .env.local for local development. On Vercel, add the same two values under
# Project → Settings → Environment Variables (Production + Preview), then redeploy.
#
# Both come from Supabase → Project Settings → API.
# The anon key is meant to be public. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
